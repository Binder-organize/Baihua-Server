# =============================================================================
# Baihua Server - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# NEVER commit .env files containing real credentials to version control!
# =============================================================================

# ---- Environment Selection ----
# Set to "production" to run in production mode.
# Leave unset or set to anything else for development mode.
#   - Development: console enabled, seed admin user, human-readable logs
#   - Production:  console disabled, no seed user, JSON logs, requires all vars set
# BAIHUA_ENV=production

# ---- Database ----
# PostgreSQL connection details. Required in production; defaulted in development.
POSTGRES_USER=baihua_user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=2423
POSTGRES_DB=baihua-database

# ---- JWT Secret ----
# MUST be set in production to a long, random string (≥256 bits).
# In development, defaults to "your-default-jwt-secret-key" if unset.
# Generate a strong secret: openssl rand -base64 64
# JWT_SECRET=your-secure-production-secret-here

# ---- Dev Seed User ----
# Password for the auto-created admin user in development mode.
# Only used when BAIHUA_ENV is NOT "production".
# In development, defaults to "admin" if unset.
# SEED_PASSWORD=admin

# ---- Application Directory ----
# Override the default app directory (~/.baihua).
# Useful for testing or custom deployments.
# BAIHUA_DIR=~/.baihua
